SYNMAP1  DFHMSD TYPE=MAP,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,TIOAPFX=YES
SYNM01   DFHMDI SIZE=(24,80)
TITLE    DFHMDF POS=(1,1),LENGTH=20,ATTRB=(PROT),INITIAL='CUSTOMER INQUIRY'
ACCT     DFHMDF POS=(3,1),LENGTH=10,ATTRB=(UNPROT)
NAME     DFHMDF POS=(4,1),LENGTH=30,ATTRB=(PROT)
SYNM02   DFHMDI SIZE=(24,80)
MSG      DFHMDF POS=(1,1),LENGTH=40,ATTRB=(PROT)
CONFIRM  DFHMDF POS=(3,1),LENGTH=1,ATTRB=(UNPROT)
REASON   DFHMDF POS=(4,1),LENGTH=30,ATTRB=(UNPROT)
         DFHMSD TYPE=FINAL
         END
